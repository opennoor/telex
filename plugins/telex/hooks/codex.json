            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
