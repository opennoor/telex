{
  "name": "@sojaner/telex",
  "version": "0.4.0",
  "description": "MCP server that lets local AI agents ask users questions through Telegram bots",
  "type": "module",
  "bin": {
    "telex": "dist/cli.js"
  },
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'),ua=process.env.npm_config_user_agent||'';if(fs.existsSync('src')&&!ua.startsWith('pnpm')){console.error('\\\\nThis repo uses pnpm. Run: corepack enable && pnpm install\\\\n');process.exit(1)}\"",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "pnpm run build",
    "telex": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "config.example.json",
    "README.md",
    "plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sojaner/telex.git"
  },
  "packageManager": "pnpm@12.3.4"
}
